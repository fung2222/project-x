# Project X — environment variables (names only; copy to .env and fill in locally; .env is git-ignored).
# Env vars take precedence over the legacy local files finnhub_config.json / marketaux_config.json / telegram_config.json.
# NEVER commit real values. NEVER paste values into logs, chats or commit messages.
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
# Telegram: whichever single bot is the final push channel (recommended: Hermes's existing bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: load secrets from another env file as well (Hermes): PX_ENV_FILE=/opt/data/.env
# Optional switches
# PX_DRY_RUN=1            # no Telegram, no file/ledger writes
# PX_TELEGRAM_DISABLED=1  # run jobs + write files, but do not send Telegram
# Every secret may also be set with a PX_ prefix (PX_TELEGRAM_CHAT_ID, PX_TELEGRAM_BOT_TOKEN, ...);
# the PX_ value wins. Use this if /opt/data/.env already has a TELEGRAM_CHAT_ID for another chat.
